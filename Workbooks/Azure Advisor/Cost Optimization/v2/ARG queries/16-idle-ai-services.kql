// Azure AI Services — Idle Deployment Candidates
// Lists Cognitive Services / AI Services accounts with their SKU and provisioning info
// NOTE: Full idle detection requires metrics data (not available in ARG). This query surfaces candidate resources for review.
resources
| where type =~ "microsoft.cognitiveservices/accounts"
| extend
    skuName = tostring(sku.name),
    aiKind = tostring(kind),
    provisioningState = tostring(properties.provisioningState),
    publicNetworkAccess = tostring(properties.publicNetworkAccess),
    customSubDomain = tostring(properties.customSubDomainName),
    endpoint = tostring(properties.endpoint)
| project id, name, aiKind, skuName, provisioningState, publicNetworkAccess, customSubDomain, location, resourceGroup, subscriptionId
| join kind=leftouter (relationshipresources | where type == 'microsoft.relationships/servicegroupmember' | where properties.TargetId =~ '{ServiceGroup}' | project _sgFilterId = tostring(properties.SourceId) | distinct _sgFilterId) on $left.id == $right._sgFilterId
| where '{ServiceGroup}' == '' or isnotempty(_sgFilterId)
| project-away _sgFilterId
| order by aiKind asc
